{
  "name": "blog-writing",
  "description": "博客文章创作流水线：调研 → 写作 → 审核",
  "mode": "relay",
  "author_label": "本文由 [用户] 与部虾创专家团联合创作",
  "schema": {
    "input": {
      "topic": { "description": "用户输入的博客主题", "type": "string", "required": true }
    },
    "working": {
      "research_data": { "description": "调研收集的素材和数据", "type": "string" },
      "draft": { "description": "博客正文草稿", "type": "string" }
    },
    "output": {
      "final_post": { "description": "最终发布文章", "type": "string" }
    }
  },
  "stages": [
    {
      "id": "research",
      "agent": "web-researcher",
      "checkpoint": true,
      "allow_read": ["topic"],
      "allow_write": ["research_data"],
      "description": "调研：收集相关素材和数据"
    },
    {
      "id": "writing",
      "agent": "content-writer",
      "checkpoint": true,
      "allow_read": ["topic", "research_data"],
      "allow_write": ["draft"],
      "description": "写作：生成博客正文"
    },
    {
      "id": "review",
      "agent": "quality-reviewer",
      "checkpoint": true,
      "allow_read": ["topic", "draft"],
      "allow_write": ["final_post"],
      "description": "审核：文章质量检查"
    }
  ],
  "interrupts": [
    {
      "stage": "writing",
      "slot": "draft",
      "message": "博客初稿已完成。输入「继续」提交审核，或告诉我修改意见。",
      "confirmKeywords": ["继续", "可以", "好的", "ok", "yes", "go"],
      "reviseKeywords": ["改", "不要", "不行", "重写", "不对"]
    }
  ],
  "slots": {
    "topic": { "type": "text", "default": "" },
    "research_data": { "type": "text", "default": "" },
    "draft": { "type": "text", "default": "" },
    "final_post": { "type": "text", "default": "" }
  }
}
