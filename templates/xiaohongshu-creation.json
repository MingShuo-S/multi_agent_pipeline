{
  "name": "xiaohongshu-creation",
  "description": "小红书种草笔记创作流水线",
  "stages": [
    {
      "id": "topic-research",
      "agent": "topic-researcher",
      "checkpoint": true,
      "allow_read": ["user_requirement"],
      "allow_write": ["topic_analysis"]
    },
    {
      "id": "content-writing",
      "agent": "content-writer",
      "checkpoint": true,
      "allow_read": ["user_requirement", "topic_analysis"],
      "allow_write": ["draft_content"]
    },
    {
      "id": "quality-review",
      "agent": "quality-reviewer",
      "checkpoint": true,
      "allow_read": ["user_requirement", "topic_analysis", "draft_content"],
      "allow_write": ["final_content"]
    }
  ],
  "slots": {
    "user_requirement": {
      "type": "text",
      "default": ""
    },
    "topic_analysis": {
      "type": "text",
      "default": ""
    },
    "draft_content": {
      "type": "text",
      "default": ""
    },
    "final_content": {
      "type": "text",
      "default": ""
    }
  }
}
